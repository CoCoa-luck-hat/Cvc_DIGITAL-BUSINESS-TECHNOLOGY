---
// Preloader Component for Astro - Real Dynamic Asset Tracking
---

<style is:global>
#preloader-overlay {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    z-index: 999999 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    overflow: hidden !important;
    user-select: none !important;
    background-color: transparent !important;
    pointer-events: auto !important;
}

#preloader-curtain-top {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 50.5vh !important;
    background-color: #08090d !important;
    z-index: 10 !important;
    border: none !important;
    will-change: transform !important;
    transform: translateY(0);
    transition: transform 0.65s cubic-bezier(0.77, 0, 0.175, 1);
    backface-visibility: hidden !important;
    -webkit-backface-visibility: hidden !important;
}

#preloader-curtain-bottom {
    position: absolute !important;
    bottom: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 50.5vh !important;
    background-color: #08090d !important;
    z-index: 10 !important;
    border: none !important;
    will-change: transform !important;
    transform: translateY(0);
    transition: transform 0.65s cubic-bezier(0.77, 0, 0.175, 1);
    backface-visibility: hidden !important;
    -webkit-backface-visibility: hidden !important;
}

#preloader-canvas {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    z-index: 20 !important;
    pointer-events: none !important;
    transition: opacity 0.35s ease;
}

#preloader-content {
    position: relative !important;
    z-index: 30 !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    width: 100% !important;
    height: 100% !important;
    padding: 2rem !important;
    text-align: center !important;
    will-change: transform, opacity !important;
    transition: opacity 0.35s ease, transform 0.35s ease;
}

.preloader-logo-wrapper {
    position: relative !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    margin-bottom: 1.5rem !important;
    will-change: transform, opacity !important;
}

.preloader-logo-img {
    height: 90px !important;
    width: auto !important;
    object-fit: contain !important;
    filter: drop-shadow(0 0 20px rgba(168, 85, 247, 0.75)) drop-shadow(0 0 45px rgba(147, 51, 234, 0.4)) !important;
    animation: preloaderLogoPulse 2.4s ease-in-out infinite alternate !important;
}

@keyframes preloaderLogoPulse {
    0% { transform: scale(0.97); filter: drop-shadow(0 0 15px rgba(168, 85, 247, 0.6)); }
    100% { transform: scale(1.02); filter: drop-shadow(0 0 28px rgba(168, 85, 247, 0.95)) drop-shadow(0 0 55px rgba(147, 51, 234, 0.5)); }
}

#preloader-counter {
    font-family: 'Prompt', -apple-system, BlinkMacSystemFont, sans-serif !important;
    font-size: 3.25rem !important;
    font-weight: 700 !important;
    color: #ffffff !important;
    letter-spacing: -0.02em !important;
    margin: 0 !important;
    padding: 0 !important;
    line-height: 1 !important;
    white-space: nowrap !important;
    text-shadow: 0 0 20px rgba(168, 85, 247, 0.5) !important;
}

.preloader-progress-track {
    width: 220px !important;
    max-width: 70vw !important;
    height: 3px !important;
    background: rgba(255, 255, 255, 0.1) !important;
    border-radius: 999px !important;
    margin: 1.25rem 0 1rem 0 !important;
    overflow: hidden !important;
    position: relative !important;
}

#preloader-progress-bar {
    height: 100% !important;
    width: 0%;
    background: linear-gradient(90deg, #9333ea 0%, #c084fc 50%, #38bdf8 100%) !important;
    box-shadow: 0 0 10px rgba(192, 132, 252, 0.8) !important;
    border-radius: 999px !important;
    transition: width 0.1s linear !important;
    will-change: width !important;
}

#preloader-title {
    font-family: 'Prompt', sans-serif !important;
    font-size: 1.05rem !important;
    font-weight: 400 !important;
    color: #e2e8f0 !important;
    letter-spacing: 0.04em !important;
    margin: 0 !important;
    padding: 0 !important;
    opacity: 0.85 !important;
    white-space: nowrap !important;
}

@media (max-width: 640px) {
    .preloader-logo-img {
        height: 72px !important;
    }
    #preloader-counter {
        font-size: 2.6rem !important;
    }
    .preloader-progress-track {
        width: 180px !important;
    }
    #preloader-title {
        font-size: 0.95rem !important;
    }
}
</style>

<!-- Preloader Overlay -->
<div id="preloader-overlay">
    <div id="preloader-curtain-top"></div>
    <div id="preloader-curtain-bottom"></div>
    <canvas id="preloader-canvas"></canvas>
    <div id="preloader-content">
        <div class="preloader-logo-wrapper">
            <img src="/02_design/DBTLOGO.webp" alt="DBT Logo" class="preloader-logo-img" width="90" height="90">
        </div>
        <div id="preloader-counter">0%</div>
        <div class="preloader-progress-track">
            <div id="preloader-progress-bar"></div>
        </div>
        <h2 id="preloader-title">แผนกวิชาเทคโนโลยีธุรกิจดิจิทัล</h2>
    </div>
</div>

<script is:inline>
(function() {
    var overlay = document.getElementById('preloader-overlay');
    if (!overlay) return;

    // Lock body scroll during preloading
    document.body.style.overflow = 'hidden';

    var counterEl = document.getElementById('preloader-counter');
    var progressBar = document.getElementById('preloader-progress-bar');
    var curtainTop = document.getElementById('preloader-curtain-top');
    var curtainBottom = document.getElementById('preloader-curtain-bottom');
    var canvas = document.getElementById('preloader-canvas');
    var contentBox = document.getElementById('preloader-content');

    var isEnded = false;
    var animFrame = null;

    // Ambient floating particles canvas
    if (canvas) {
        var ctx = canvas.getContext('2d');
        var w = (canvas.width = window.innerWidth);
        var h = (canvas.height = window.innerHeight);

        var particles = [];
        for (var i = 0; i < 20; i++) {
            particles.push({
                x: Math.random() * w,
                y: Math.random() * h,
                vx: (Math.random() - 0.5) * 0.6,
                vy: (Math.random() - 0.5) * 0.6,
                radius: Math.random() * 2 + 1,
                alpha: Math.random() * 0.4 + 0.15
            });
        }

        function renderParticles() {
            if (isEnded) return;
            ctx.clearRect(0, 0, w, h);
            for (var j = 0; j < particles.length; j++) {
                var p = particles[j];
                p.x += p.vx;
                p.y += p.vy;
                if (p.x < 0 || p.x > w) p.vx *= -1;
                if (p.y < 0 || p.y > h) p.vy *= -1;
                ctx.fillStyle = 'rgba(168, 85, 247, ' + p.alpha + ')';
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                ctx.fill();
            }
            animFrame = requestAnimationFrame(renderParticles);
        }
        animFrame = requestAnimationFrame(renderParticles);
    }

    // Dismissal function: Split Curtains and Reveal Page
    function completePreloader() {
        if (isEnded) return;
        isEnded = true;

        if (animFrame) cancelAnimationFrame(animFrame);

        // Ensure 100% is displayed
        if (counterEl) counterEl.textContent = '100%';
        if (progressBar) progressBar.style.width = '100%';

        // Smooth exit sequence
        setTimeout(function() {
            if (contentBox) {
                contentBox.style.opacity = '0';
                contentBox.style.transform = 'scale(0.96)';
            }
            if (canvas) {
                canvas.style.opacity = '0';
            }
            if (curtainTop) {
                curtainTop.style.transform = 'translateY(-100%)';
            }
            if (curtainBottom) {
                curtainBottom.style.transform = 'translateY(100%)';
            }

            // Unlock body scroll as curtain splits open
            document.body.style.overflow = '';

            // Notify page components (GSAP, videos, sliders)
            window.dispatchEvent(new CustomEvent('preloaderComplete'));

            // Remove overlay from DOM
            setTimeout(function() {
                if (overlay && overlay.parentNode) {
                    overlay.parentNode.removeChild(overlay);
                }
                if (window.ScrollTrigger) window.ScrollTrigger.refresh();
            }, 700);
        }, 220);
    }

    // Dynamic Image & Asset Loader Tracking
    var loadedCount = 0;
    var totalCount = 0;
    var currentPercent = 0;
    var targetPercent = 0;
    var trackedImages = new Set();

    function updateProgress() {
        if (totalCount > 0) {
            targetPercent = Math.min(100, Math.round((loadedCount / totalCount) * 100));
        } else {
            targetPercent = 100;
        }
    }

    function onAssetDone() {
        loadedCount++;
        updateProgress();
    }

    function trackImage(img) {
        if (!img || trackedImages.has(img)) return;
        trackedImages.add(img);
        totalCount++;

        // If image is already cached/complete
        if (img.complete && img.naturalWidth !== 0) {
            onAssetDone();
        } else {
            img.addEventListener('load', onAssetDone, { once: true });
            img.addEventListener('error', onAssetDone, { once: true });
        }
    }

    function scanImages() {
        var imgs = document.querySelectorAll('img');
        for (var i = 0; i < imgs.length; i++) {
            trackImage(imgs[i]);
        }
    }

    // Initial scan of already parsed images
    scanImages();

    // Secondary scan when DOM is fully ready to catch any remaining images
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', scanImages);
    }

    // Font readiness tracking
    if (document.fonts && document.fonts.ready) {
        totalCount++;
        document.fonts.ready.then(function() {
            onAssetDone();
        }).catch(function() {
            onAssetDone();
        });
    }

    // Smooth RAF Interpolator for Counter (Eases smoothly towards targetPercent)
    function tickProgress() {
        if (isEnded) return;

        // If target is ahead, increment with smooth interpolation
        if (currentPercent < targetPercent) {
            var step = Math.max(1, Math.ceil((targetPercent - currentPercent) * 0.12));
            currentPercent = Math.min(targetPercent, currentPercent + step);

            if (counterEl) counterEl.textContent = currentPercent + '%';
            if (progressBar) progressBar.style.width = currentPercent + '%';
        }

        // When all tracked assets are resolved and visual counter reached 100%
        if (currentPercent >= 100 && loadedCount >= totalCount) {
            completePreloader();
            return;
        }

        requestAnimationFrame(tickProgress);
    }

    requestAnimationFrame(tickProgress);
})();
</script>
