---
// Features Gallery Panorama Section
import ImageLoader from '../ImageLoader.astro';
---

<section id="gallery-horizontal-section" class="w-full relative z-40 bg-neutral-bg mt-12 md:mt-36 border-t border-gray-200/60 pt-6 md:pt-8">
    <div class="gallery-sticky">
        
        <!-- Top Header (Aligned with site layout) -->
        <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-16 w-full pt-2 md:pt-4 gallery-header-anim">
            <span class="text-primary font-semibold text-xs tracking-[0.2em] uppercase block mb-1">GALLERY</span>
            <div class="flex flex-col md:flex-row md:items-baseline md:justify-between">
                <h2 class="text-2xl sm:text-3xl md:text-5xl font-bold text-gray-900 leading-none">เริ่มต้นอนาคตดีๆ</h2>
                <p class="text-xs sm:text-sm md:text-base text-gray-500 font-medium mt-1 md:mt-0">ที่วิทยาลัยอาชีวศึกษาเชียงราย</p>
            </div>
            <hr class="w-12 border-t-2 border-primary mt-3 md:mt-4">
        </div>

        <!-- Middle Horizontal Panorama Cards Track -->
        <div class="gallery-horizontal-track" data-lenis-prevent>
            
            <!-- Card 1 -->
            <div class="panorama-card">
                <div class="panorama-img-wrapper">
                    <ImageLoader src="/02_design/1.webp" width="1200" height="800" alt="สายอาชีพธุรกิจดิจิทัล รายได้สูง ตลาดต้องการ" class="w-full h-full" imgClass="w-full h-full object-cover" loading="lazy" decoding="async" />
                </div>
                <div class="hidden lg:flex justify-between items-center px-2 mt-4">
                    <h4 class="text-xl md:text-2xl font-bold text-gray-900 leading-tight">Digital Business Careers</h4>
                    <span class="text-sm font-bold text-primary tracking-widest ml-4">01</span>
                </div>
            </div>

            <!-- Card 2 -->
            <div class="panorama-card">
                <div class="panorama-img-wrapper">
                    <ImageLoader src="/02_design/2.webp" width="1200" height="800" alt="ครูและอาจารย์เข้าถึงง่าย พร้อมให้คำปรึกษาใกล้ชิด" class="w-full h-full" imgClass="w-full h-full object-cover" loading="lazy" decoding="async" />
                </div>
                <div class="hidden lg:flex justify-between items-center px-2 mt-4">
                    <h4 class="text-xl md:text-2xl font-bold text-gray-900 leading-tight">Mentorship &amp; Guidance</h4>
                    <span class="text-sm font-bold text-primary tracking-widest ml-4">02</span>
                </div>
            </div>

            <!-- Card 3 -->
            <div class="panorama-card">
                <div class="panorama-img-wrapper">
                    <ImageLoader src="/02_design/3.webp" width="1200" height="800" alt="เรียนแบบลงมือทำจริง สร้างโปรเจกต์จริงในห้องปฏิบัติการ" class="w-full h-full" imgClass="w-full h-full object-cover" loading="lazy" decoding="async" />
                </div>
                <div class="hidden lg:flex justify-between items-center px-2 mt-4">
                    <h4 class="text-xl md:text-2xl font-bold text-gray-900 leading-tight">Practical Learning</h4>
                    <span class="text-sm font-bold text-primary tracking-widest ml-4">03</span>
                </div>
            </div>

            <!-- Card 4 -->
            <div class="panorama-card">
                <div class="panorama-img-wrapper">
                    <ImageLoader src="/02_design/4.webp" width="1200" height="800" alt="สังคมเปิดกว้าง ส่งเสริมความหลากหลายและเป็นตัวเองได้เต็มที่" class="w-full h-full" imgClass="w-full h-full object-cover" loading="lazy" decoding="async" />
                </div>
                <div class="hidden lg:flex justify-between items-center px-2 mt-4">
                    <h4 class="text-xl md:text-2xl font-bold text-gray-900 leading-tight">Diversity &amp; Creative Space</h4>
                    <span class="text-sm font-bold text-primary tracking-widest ml-4">04</span>
                </div>
            </div>

            <!-- Card 5 -->
            <div class="panorama-card">
                <div class="panorama-img-wrapper">
                    <ImageLoader src="/02_design/5.webp" width="1200" height="800" alt="กิจกรรมแน่น บรรยากาศการเรียนรู้อบอุ่นและมีชีวิตชีวา" class="w-full h-full" imgClass="w-full h-full object-cover" loading="lazy" decoding="async" />
                </div>
                <div class="hidden lg:flex justify-between items-center px-2 mt-4">
                    <h4 class="text-xl md:text-2xl font-bold text-gray-900 leading-tight">Vibrant Campus Life</h4>
                    <span class="text-sm font-bold text-primary tracking-widest ml-4">05</span>
                </div>
            </div>

            <!-- Card 6 -->
            <div class="panorama-card">
                <div class="panorama-img-wrapper">
                    <ImageLoader src="/02_design/6.webp" width="1200" height="800" alt="สร้างสรรค์ผลงานและนวัตกรรมธุรกิจดิจิทัลสู่รางวัลระดับชาติ" class="w-full h-full" imgClass="w-full h-full object-cover" loading="lazy" decoding="async" />
                </div>
                <div class="hidden lg:flex justify-between items-center px-2 mt-4">
                    <h4 class="text-xl md:text-2xl font-bold text-gray-900 leading-tight">Excellence &amp; Innovation</h4>
                    <span class="text-sm font-bold text-primary tracking-widest ml-4">06</span>
                </div>
            </div>

        </div>

        <!-- Bottom Scroll Ruler Progress Navigation -->
        <div class="bottom-scroll-ruler">
            <span class="ruler-item active">01/CAREERS</span>
            <span class="ruler-item">02/MENTORSHIP</span>
            <span class="ruler-item">03/PRACTICAL</span>
            <span class="ruler-item">04/DIVERSITY</span>
            <span class="ruler-item">05/CAMPUS LIFE</span>
            <span class="ruler-item">06/INNOVATION</span>
        </div>

    </div>
</section>

<style>
.panorama-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex-shrink: 0;
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
}

.panorama-img-wrapper {
    aspect-ratio: 3 / 2;
    height: 78%;
    width: auto;
    position: relative;
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.1);
    border: 1px solid rgba(0, 0, 0, 0.04);
    background-color: transparent;
}

.panorama-img-wrapper :global(.img-loader-wrapper) {
    width: 100%;
    height: 100%;
    border-radius: 28px;
    background-color: transparent !important;
}

.panorama-img-wrapper :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 28px;
    transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
}

.panorama-card:hover {
    transform: translateY(-8px);
}

.panorama-card:hover .panorama-img-wrapper :global(img) {
    transform: scale(1.04);
}
</style>
