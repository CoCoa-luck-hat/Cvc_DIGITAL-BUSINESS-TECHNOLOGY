---
// Careers & Degree Comparison Section
---

<section id="careers-reveal-section" class="w-full relative">
    <div class="reveal-sticky">
        
        <!-- BEFORE LAYER (Traditional / Gray) -->
        <div class="reveal-layer layer-before flex items-center">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
                <div class="reveal-grid items-center gap-12">
                    
                    <!-- Left: Graphic Mockup -->
                    <div class="flex flex-col space-y-6 order-2 md:order-1">
                        <div class="bg-white border border-gray-200/80 rounded-3xl p-6 md:p-8 shadow-xl">
                            <span class="text-xs text-gray-500 font-bold uppercase tracking-widest block mb-1 fade-heading-in-only">TRADITIONAL WORKFORCE</span>
                            <h3 class="text-xl font-bold text-gray-700 mb-6 fade-heading-in-only">งานสำนักงานทั่วไปที่ขาดทักษะดิจิทัล</h3>
                            
                            <div class="space-y-4">
                                <div class="flex items-center space-x-4 p-4 bg-gray-50 rounded-2xl border border-gray-100">
                                    <div class="w-10 h-10 rounded-xl bg-gray-200 flex items-center justify-center text-gray-600">
                                        <i class="fas fa-wallet"></i>
                                    </div>
                                    <div>
                                        <div class="text-xs text-gray-500">รายได้เฉลี่ยเริ่มต้น</div>
                                        <div class="text-sm font-semibold text-gray-700">10,000 - 15,000 บาท / เดือน</div>
                                    </div>
                                </div>
                                <div class="flex items-center space-x-4 p-4 bg-gray-50 rounded-2xl border border-gray-100">
                                    <div class="w-10 h-10 rounded-xl bg-gray-200 flex items-center justify-center text-gray-600">
                                        <i class="fas fa-exclamation-triangle"></i>
                                    </div>
                                    <div>
                                        <div class="text-xs text-gray-500">ลักษณะงาน</div>
                                        <div class="text-sm font-semibold text-gray-700">ทำงานเอกสารซ้ำซาก ไม่ได้ใช้เทคโนโลยีดิจิทัล เสี่ยงถูก AI ทดแทน</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Right: Text Content -->
                    <div class="flex flex-col items-start order-1 md:order-2">
                        <span class="text-gray-500 font-semibold text-xs tracking-[0.2em] uppercase mb-3 fade-heading-in-only">CAREERS IN THE PAST</span>
                        <h2 class="text-3xl md:text-6xl font-extrabold text-gray-600 leading-tight uppercase mb-6 fade-heading-in-only">
                            เมื่อขาดทักษะ<br>
                            ธุรกิจดิจิทัล
                        </h2>
                        <p class="text-gray-600 text-sm md:text-base leading-relaxed">
                            ในยุคเศรษฐกิจดิจิทัล องค์กรทุกระดับต้องการบุคลากรที่ผสมผสานความรู้ด้านธุรกิจและเทคโนโลยีเข้าด้วยกัน การไร้ทักษะดิจิทัลทำให้โอกาสการเติบโตและฐานเงินเดือนถูกจำกัด
                        </p>
                    </div>
                    
                </div>
            </div>
        </div>
        
        <!-- AFTER LAYER (Modern / Vivid Digital Violet Accent) -->
        <div class="reveal-layer layer-after flex items-center">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
                <div class="reveal-grid items-center gap-12">
                    
                    <!-- Left: Graphic Mockup -->
                    <div class="flex flex-col space-y-6 order-2 md:order-1">
                        <div class="bg-white border border-primary/20 rounded-3xl p-6 md:p-8 shadow-2xl relative overflow-hidden">
                            <!-- Glow aura in card background -->
                            <div class="absolute -right-10 -top-10 w-48 h-48 bg-primary/10 rounded-full blur-3xl"></div>
                            
                            <span class="text-xs text-primary font-bold uppercase tracking-widest block mb-1 fade-heading-in-only">DIGITAL BUSINESS TECHNOLOGY</span>
                            <h3 class="text-xl font-bold text-gray-900 mb-6 fade-heading-in-only">นักบริหารและผู้สร้างสรรค์ดิจิทัล DBT</h3>
                            
                            <div class="space-y-4">
                                <div class="flex items-center space-x-4 p-4 bg-purple-50/50 rounded-2xl border border-primary/15">
                                    <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
                                        <i class="fas fa-chart-line"></i>
                                    </div>
                                    <div>
                                        <div class="text-xs text-gray-500">รายได้เฉลี่ยเริ่มต้น</div>
                                        <div class="text-sm font-bold text-primary neon-glow">20,000 - 65,000+ บาท / เดือน</div>
                                    </div>
                                </div>
                                <div class="flex items-center space-x-4 p-4 bg-purple-50/50 rounded-2xl border border-primary/15">
                                    <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
                                        <i class="fas fa-bullhorn"></i>
                                    </div>
                                    <div>
                                        <div class="text-xs text-gray-500">ตำแหน่งงานรองรับ</div>
                                        <div class="text-sm font-semibold text-gray-800">Digital Marketer • E-Commerce • Data Analyst</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Right: Text Content -->
                    <div class="flex flex-col items-start order-1 md:order-2">
                        <span class="text-primary font-semibold text-xs tracking-[0.2em] uppercase mb-3 fade-heading-in-only">FUTURE WORKFORCE</span>
                        <h2 class="text-3xl md:text-6xl font-extrabold text-gray-950 leading-tight uppercase mb-6 fade-heading-in-only">
                            มุ่งสู่ผู้นำด้าน<br>
                            ธุรกิจดิจิทัล DBT CVC
                        </h2>
                        <p class="text-gray-600 text-sm md:text-base leading-relaxed mb-8">
                            ติดปีกสายอาชีพด้วยทักษะการตลาดออนไลน์ พาณิชย์อิเล็กทรอนิกส์ การผลิตสื่อสร้างสรรค์ และการวิเคราะห์ข้อมูล พร้อมเป็นผู้ประกอบการรุ่นใหม่ที่เติบโตอย่างมั่นคง
                        </p>
                        
                        <div class="flex flex-wrap gap-2">
                            <span class="px-3.5 py-1 bg-primary/10 text-primary-hover text-xs font-semibold rounded-full border border-primary/20">Digital Marketing</span>
                            <span class="px-3.5 py-1 bg-primary/10 text-primary-hover text-xs font-semibold rounded-full border border-primary/20">E-Commerce Specialist</span>
                            <span class="px-3.5 py-1 bg-primary/10 text-primary-hover text-xs font-semibold rounded-full border border-primary/20">Graphic &amp; Multimedia</span>
                            <span class="px-3.5 py-1 bg-primary/10 text-primary-hover text-xs font-semibold rounded-full border border-primary/20">Data Analytics</span>
                            <span class="px-3.5 py-1 bg-primary/10 text-primary-hover text-xs font-semibold rounded-full border border-primary/20">Online Entrepreneur</span>
                        </div>
                    </div>
                    
                </div>
            </div>
        </div>
        
        <!-- DIVIDER LINE -->
        <div class="reveal-divider">
            <div class="reveal-divider-handle">
                <i class="fas fa-arrows-alt-v"></i>
            </div>
        </div>
        
    </div>
</section>

<!-- Section: Kora Comparison ("DBT Career Degree Pathways") -->
<section id="koraComparisonSection" class="kora-comparison-section relative z-10 w-full bg-[#fafaf7] text-[#242424] h-[220vh]">
    <div class="kora-sticky-viewport min-h-screen relative flex items-center justify-center overflow-hidden px-4 sm:px-6 lg:px-8 pt-16 pb-8 z-10">
        
        <!-- Center Stage Container -->
        <div class="kora-stage-wrapper relative w-full max-w-[1080px] h-[580px] max-h-[75vh] flex items-center justify-center">
            
            <!-- 1. Animated Main Title (Split Text: Line 1 Left, Line 2 Right) -->
            <div id="koraTitleBox" class="kora-title-box absolute inset-0 flex flex-col items-center justify-center z-10 pointer-events-none px-4 sm:px-8">
                <div class="max-w-5xl w-full mx-auto flex flex-col space-y-2">
                    <h2 id="koraTitleLine1" class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-[#242424] leading-[1.05] text-left self-start sm:ml-4 md:ml-8" style="will-change: transform, opacity;">
                        เส้นทางสายอาชีพ <span class="text-[#616161] font-normal">ธุรกิจดิจิทัล</span>
                    </h2>
                    <h2 id="koraTitleLine2" class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-normal tracking-tight text-[#616161] leading-[1.05] text-right self-end sm:mr-4 md:mr-8" style="will-change: transform, opacity;">
                        แยกตามระดับวุฒิ
                    </h2>
                </div>
            </div>

            <!-- 2. Animated Cards Container (Absolute Centered Overlay) -->
            <div id="koraCardsContainer" class="kora-cards-container absolute inset-0 w-full flex items-center justify-center z-20 pointer-events-auto" style="will-change: opacity, transform;">
                
                <!-- Card 1: ปวช. DBT -->
                <div id="koraCardBefore" class="kora-card kora-card-before absolute bg-white rounded-[36px] sm:rounded-[40px] p-6 sm:p-8 shadow-xl flex flex-col justify-between border border-gray-200/80 w-full max-w-[360px] h-[510px] max-h-[72vh] overflow-hidden">
                    <div class="space-y-4">
                        <!-- Header / Badge -->
                        <div>
                            <span class="text-xs font-semibold tracking-wider text-primary block mb-1.5 uppercase">VOCATIONAL CERTIFICATE</span>
                            <div class="flex items-center text-gray-900 font-bold text-base sm:text-lg tracking-tight">
                                <div class="kora-icon-box border-2 border-primary">
                                    <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0112 20.055a11.952 11.952 0 01-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path></svg>
                                </div>
                                <span>วุฒิ ปวช. เทคโนโลยีธุรกิจดิจิทัล</span>
                            </div>
                        </div>
                        
                        <!-- Main Card Headline -->
                        <h3 class="text-xl sm:text-2xl font-bold text-gray-900 leading-snug">
                            ปูพื้นฐานธุรกิจดิจิทัลแน่น<br>พร้อมต่อยอดทันที
                        </h3>
                    </div>

                    <!-- Item List -->
                    <div class="pt-4 border-t border-gray-100">
                        <div class="kora-item text-gray-700">
                            <div class="kora-icon-box">
                                <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                            </div>
                            <span class="text-xs sm:text-sm font-medium leading-snug">โปรแกรมสำนักงาน &amp; ข้อมูลธุรกิจ</span>
                        </div>

                        <div class="kora-item text-gray-700">
                            <div class="kora-icon-box">
                                <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            </div>
                            <span class="text-xs sm:text-sm font-medium leading-snug">กราฟิกดีไซน์ &amp; ผลิตสื่อดิจิทัล</span>
                        </div>

                        <div class="kora-item text-gray-700">
                            <div class="kora-icon-box">
                                <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            </div>
                            <span class="text-xs sm:text-sm font-medium leading-snug">เงินเดือน 15,000 - 25,000 บาท</span>
                        </div>

                        <div class="kora-item text-gray-700">
                            <div class="kora-icon-box">
                                <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                            </div>
                            <span class="text-xs sm:text-sm font-medium leading-snug">ต่อยอด ปวส. หรือ ป.ตรี ทันที</span>
                        </div>
                    </div>
                </div>

                <!-- Card 2: ปวส. DBT -->
                <div id="koraCardAfter" class="kora-card kora-card-after absolute bg-[#5f2d8c] text-white rounded-[36px] sm:rounded-[40px] p-6 sm:p-8 shadow-2xl flex flex-col justify-between border border-purple-400/30 w-full max-w-[360px] h-[510px] max-h-[72vh] overflow-hidden">
                    <div class="space-y-4">
                        <!-- Header / Badge -->
                        <div>
                            <span class="text-xs font-semibold tracking-wider text-purple-200 block mb-1.5 uppercase">HIGH DIPLOMA</span>
                            <div class="flex items-center text-white font-bold text-base sm:text-lg tracking-tight">
                                <div class="kora-icon-box border-2 border-white bg-white/10">
                                    <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path></svg>
                                </div>
                                <span>วุฒิ ปวส. เทคโนโลยีธุรกิจดิจิทัล</span>
                            </div>
                        </div>
                        
                        <!-- Main Card Headline -->
                        <h3 class="text-xl sm:text-2xl font-bold text-white leading-snug">
                            ก้าวสู่ผู้เชี่ยวชาญ<br>การตลาด &amp; ธุรกิจดิจิทัล
                        </h3>
                    </div>

                    <!-- Item List -->
                    <div class="pt-4 border-t border-white/20">
                        <div class="kora-item text-white">
                            <div class="kora-icon-box bg-white/10">
                                <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                            </div>
                            <span class="text-xs sm:text-sm font-medium leading-snug">Digital Marketing &amp; E-Commerce</span>
                        </div>

                        <div class="kora-item text-white">
                            <div class="kora-icon-box bg-white/10">
                                <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                            </div>
                            <span class="text-xs sm:text-sm font-medium leading-snug">Data Analytics &amp; SME Solution</span>
                        </div>

                        <div class="kora-item text-white">
                            <div class="kora-icon-box bg-white/10">
                                <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            </div>
                            <span class="text-xs sm:text-sm font-medium leading-snug">เงินเดือน 25,000 - 65,000+ บาท</span>
                        </div>

                        <div class="kora-item text-white">
                            <div class="kora-icon-box bg-white/10">
                                <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                            </div>
                            <span class="text-xs sm:text-sm font-medium leading-snug">พร้อมเป็นผู้ประกอบการ &amp; องค์กรชั้นนำ</span>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </div>
</section>
