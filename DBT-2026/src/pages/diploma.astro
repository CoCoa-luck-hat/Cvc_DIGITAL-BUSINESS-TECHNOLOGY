---
import Layout from '../layouts/Layout.astro';
import Dip1 from '../components/diploma/Dip1.astro';
import Dip2 from '../components/diploma/Dip2.astro';
import Dip3 from '../components/diploma/Dip3.astro';
import Dip4 from '../components/diploma/Dip4.astro';
import Dip5 from '../components/diploma/Dip5.astro';
---

<Layout
  title="หลักสูตร ปวส. เทคโนโลยีธุรกิจดิจิทัล | แผนกวิชาเทคโนโลยีธุรกิจดิจิทัล CVC"
  description="หลักสูตรประกาศนียบัตรวิชาชีพชั้นสูง (ปวส.) สาขาวิชาเทคโนโลยีธุรกิจดิจิทัล วิทยาลัยอาชีวศึกษาเชียงราย มุ่งสู่ผู้เชี่ยวชาญการตลาดดิจิทัลและอีคอมเมิร์ซ"
  currentPath="/diploma"
>
    <Dip1 />
    <Dip2 />
    <Dip3 />
    <Dip4 />
    <Dip5 />
</Layout>
