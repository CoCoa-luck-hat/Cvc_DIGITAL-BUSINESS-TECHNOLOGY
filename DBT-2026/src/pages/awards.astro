---
import Layout from '../layouts/Layout.astro';

const graduates = [
    // ── ผลงานและรางวัลแผนกวิชา (Department Awards) ──────────────────────
    {
        src: "/03_photo/3.5_ผลงานแผนก/67แข่งทักษะปวช.webp",
        category: "dept",
        year: "2567",
        level: "pvc",
        levelLabel: "ผลงานแผนกวิชา (ปวช.)",
        title: "รางวัลการแข่งขันทักษะวิชาชีพ ระดับ ปวช.",
        desc: "การแข่งขันทักษะวิชาชีพและการประกวดนวัตกรรมสิ่งประดิษฐ์คนรุ่นใหม่ ระดับ ปวช. ประจำปีการศึกษา 2567"
    },
    {
        src: "/03_photo/3.5_ผลงานแผนก/67แข่งทักษะปวส.webp",
        category: "dept",
        year: "2567",
        level: "pvs",
        levelLabel: "ผลงานแผนกวิชา (ปวส.)",
        title: "รางวัลการแข่งขันทักษะวิชาชีพ ระดับ ปวส.",
        desc: "การแข่งขันทักษะการพัฒนานวัตกรรมธุรกิจดิจิทัลและพาณิชย์อิเล็กทรอนิกส์ ระดับ ปวส. ประจำปีการศึกษา 2567"
    },
    {
        src: "/03_photo/3.5_ผลงานแผนก/วิทยากร.webp",
        category: "dept",
        year: "all",
        level: "all",
        levelLabel: "บริการวิชาการ",
        title: "บริการวิชาการและวิทยากรด้านดิจิทัล",
        desc: "คณะครูและบุคลากรแผนกวิชาเทคโนโลยีธุรกิจดิจิทัลร่วมเป็นวิทยากรถ่ายทอดความรู้และทักษะเทคโนโลยีดิจิทัลแก่ชุมชน"
    },
    {
        src: "/03_photo/3.5_ผลงานแผนก/ศูนย์ซ่อม.webp",
        category: "dept",
        year: "all",
        level: "all",
        levelLabel: "จิตอาสา Fix It",
        title: "โครงการศูนย์ซ่อมสร้างเพื่อชุมชน (Fix It Center)",
        desc: "กิจกรรมจิตอาสาบริการวิชาชีพเพื่อชุมชน ร่วมดูแล ให้คำปรึกษา และซ่อมบำรุงระบบเทคโนโลยีสารสนเทศแก่ประชาชน"
    },

    // ── ผลงานและรางวัลนักเรียน-นักศึกษา (Student Works & Awards) ─────────
    {
        src: "/03_photo/3.6_ผลงานนักเรียน/โมชันกราฟิก.webp",
        category: "student",
        year: "2567",
        level: "pvc",
        levelLabel: "ผลงานนักเรียนดีเด่น",
        title: "ผลงานการออกแบบโมชันกราฟิกและสื่อดิจิทัลคอนเทนต์",
        desc: "ผลงานสร้างสรรค์โมชันกราฟิกและแอนิเมชันเพื่อการประชาสัมพันธ์ธุรกิจดิจิทัล โดยนักเรียนแผนกวิชาเทคโนโลยีธุรกิจดิจิทัล"
    },
    {
        src: "/03_photo/3.6_ผลงานนักเรียน/ยูยิตสู.webp",
        category: "student",
        year: "2567",
        level: "pvc",
        levelLabel: "รางวัลเหรียญทอง",
        title: "เหรียญทองกีฬายูยิตสูชิงชนะเลิศระดับชาติ",
        desc: "นักศึกษาแผนกวิชาเทคโนโลยีธุรกิจดิจิทัลคว้ารางวัลชนะเลิศเหรียญทอง การแข่งขันกีฬายูยิตสูชิงแชมป์ประเทศไทย"
    }
];

const totalCount = graduates.length;
---

<Layout
  title="ผลงานและรางวัลเชิดชูเกียรติ | แผนกวิชาเทคโนโลยีธุรกิจดิจิทัล CVC"
  description="ทำเนียบผลงาน รางวัลเชิดชูเกียรติ และความสำเร็จของนักเรียน นักศึกษา และแผนกวิชาเทคโนโลยีธุรกิจดิจิทัล วิทยาลัยอาชีวศึกษาเชียงราย"
  currentPath="/awards"
  moduleCss="/include/css/modules/graduate.css"
  moduleJs="/include/js/modules/graduate.js"
>
    <!-- MAIN SPLIT-SCREEN GRADUATE STUDIO COMPONENT -->
    <section id="split-graduate-studio">
        <!-- Blueprint Atmospheric Grid -->
        <div class="split-blueprint-grid"></div>
        <div class="split-ambient-glow"></div>

        <div class="split-stage-wrapper">
            <!-- ── Left Control & Info Hub ─────────────────────────────────── -->
            <div class="split-left-panel">
                <h1 class="split-title">
                    ผลงาน รางวัล <br />
                    <span class="split-title-crimson">&amp; เกียรติยศ DBT</span>
                </h1>

                <p class="split-desc">
                    บันทึกความสำเร็จ ผลงาน และรางวัลเกียรติยศ แผนกวิชาเทคโนโลยีธุรกิจดิจิทัล วิทยาลัยอาชีวศึกษาเชียงราย
                </p>

                <div class="split-filters-box">
                    <!-- หมวดหมู่ผลงาน / ทำเนียบ -->
                    <div>
                        <p class="split-filter-label">เลือกหมวดหมู่</p>
                        <div class="split-categories-group" role="tablist">
                            <button type="button" class="split-btn-category active" data-category="all">
                                <span>ทั้งหมด</span>
                            </button>
                            <button type="button" class="split-btn-category" data-category="dept">
                                <span>ผลงานแผนกฯ</span>
                            </button>
                            <button type="button" class="split-btn-category" data-category="student">
                                <span>ผลงานนักเรียน</span>
                            </button>
                        </div>
                    </div>

                    <!-- Academic Year Filter -->
                    <div>
                        <p class="split-filter-label">เลือกปีการศึกษา / รุ่น</p>
                        <div class="split-years-group" role="tablist">
                            <button type="button" class="split-btn-year active" data-year="all">
                                <span>ทุกปี</span>
                            </button>
                            <button type="button" class="split-btn-year" data-year="2567">
                                <span>ปี 2567</span>
                            </button>
                        </div>
                    </div>

                    <!-- Degree Level Filter -->
                    <div>
                        <p class="split-filter-label">เลือกระดับชั้น</p>
                        <div class="split-levels-group" role="tablist">
                            <button type="button" class="split-btn-level active" data-level="all">
                                <span>ทั้งหมด</span>
                            </button>
                            <button type="button" class="split-btn-level" data-level="pvc">
                                <span>ปวช.</span>
                            </button>
                            <button type="button" class="split-btn-level" data-level="pvs">
                                <span>ปวส.</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Action & Status Bar -->
                <div class="split-action-bar">
                    <span class="split-sheet-counter" id="split-sheet-counter">
                        <i class="fas fa-images" style="color: #94a3b8; font-size: 12px;"></i>
                        <span id="split-counter-text">รายการที่ 1 / {totalCount}</span>
                    </span>
                    <span class="split-sheet-badge-level" id="split-sheet-badge-level">DBT CVC</span>
                </div>
            </div>

            <!-- ── Right Cinema Showcase Stage ─────────────────────────────── -->
            <div class="split-right-panel">
                <!-- Main Showcase Frame -->
                <div class="split-cinema-stage" id="split-cinema-stage">
                    <div class="split-cinema-badge" id="split-cinema-badge">
                        <span id="split-badge-text">ผลงานแผนกวิชา DBT</span>
                    </div>

                    <div class="split-cinema-zoom-btn" title="ขยายดูภาพฉบับเต็ม" onclick="openSplitLightbox(0)">
                        <i class="fas fa-expand"></i>
                    </div>

                    <!-- Navigational Arrow Controls -->
                    <button type="button" class="split-nav-btn split-nav-prev" id="split-nav-prev" aria-label="ภาพก่อนหน้า">
                        <i class="fas fa-chevron-left"></i>
                    </button>

                    <div class="split-main-image-wrap" onclick="openSplitLightbox(0)">
                        <img src="" alt="" class="split-main-img" id="split-main-img" />
                    </div>

                    <button type="button" class="split-nav-btn split-nav-next" id="split-nav-next" aria-label="ภาพถัดไป">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </div>

                <!-- Horizontal Mini-Thumbnail Drawer -->
                <div class="split-thumb-drawer" id="split-thumb-drawer">
                    <!-- Thumbnail items injected by JS -->
                </div>
            </div>
        </div>
    </section>

    <!-- Cinematic Ultra-Minimal Lightbox Modal -->
    <div id="split-lightbox-modal" role="dialog" aria-modal="true" aria-label="ผลงานและรางวัลเกียรติยศขนาดใหญ่">
        <div class="split-lb-top-bar">
            <div class="split-lb-left-brand">
                <span class="split-lb-badge" id="split-lb-badge">ผลงานและรางวัลเกียรติยศ DBT CVC</span>
            </div>
            <div class="split-lb-top-right">
                <span class="split-lb-counter-pill" id="split-lb-counter">1 / {totalCount}</span>
                <button type="button" class="split-lb-close-btn" id="split-btn-close-lb" aria-label="ปิดหน้าต่าง">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>

        <div class="split-lb-stage" id="split-lb-stage">
            <button type="button" class="split-lb-nav-btn split-lb-prev" id="split-btn-prev-lb" aria-label="ภาพก่อนหน้า">
                <i class="fas fa-chevron-left"></i>
            </button>

            <div class="split-lb-img-wrap" id="split-lb-img-wrap">
                <img src="" alt="" class="split-lb-main-img" id="split-lb-main-img" />
                <div class="split-lb-caption-bar">
                    <h3 class="split-lb-caption-title" id="split-lb-title"></h3>
                    <p class="split-lb-caption-text" id="split-lb-desc"></p>
                </div>
            </div>

            <button type="button" class="split-lb-nav-btn split-lb-next" id="split-btn-next-lb" aria-label="ภาพถัดไป">
                <i class="fas fa-chevron-right"></i>
            </button>
        </div>
    </div>

    <!-- Pass Graduate Data & Load Modular Engine -->
    <script is:inline define:vars={{ graduates }}>
        window.__GRADUATES_DATA__ = graduates;
        const urlParams = new URLSearchParams(window.location.search);
        let initCat = 'all';
        const click = urlParams.get('click');
        if (click === 'awards_dbt' || click === 'awards_it' || click === 'awards_dept') {
            initCat = 'dept';
        } else if (click === 'awards_student' || click === 'awards_sd' || click === 'awards_stu') {
            initCat = 'student';
        }
        if (urlParams.get('category')) {
            initCat = urlParams.get('category');
        }
        window.__GRADUATES_INITIAL_CATEGORY__ = initCat;
        window.__GRADUATES_INITIAL_YEAR__ = "all";
    </script>
</Layout>
