---
import Preloader from '../components/Preloader.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  moduleCss?: string;
  moduleJs?: string;
  isHome?: boolean;
}

const {
  title = 'แผนกวิชาเทคโนโลยีธุรกิจดิจิทัล | วิทยาลัยอาชีวศึกษาเชียงราย (CVC)',
  description = 'หลักสูตรวิชาชีพด้านเทคโนโลยีธุรกิจดิจิทัล นวัตกรรมธุรกิจ ข้อมูลและอีคอมเมิร์ซ วิทยาลัยอาชีวศึกษาเชียงราย มุ่งสู่อนาคตดิจิทัลระดับมืออาชีพ',
  currentPath = '/',
  moduleCss,
  moduleJs,
  isHome = (currentPath === '/' || currentPath === '' || currentPath === '/index.html')
} = Astro.props;

const canonicalUrl = `https://cvcdigitalbusinesstechnology.netlify.app${currentPath}`;
const ogImageUrl = '/02_design/DBTLOGO.webp';
---

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta name="description" content={description} />
    <meta name="keywords" content="เทคโนโลยีธุรกิจดิจิทัล, DBT, อาชีวะเชียงราย, CVC, ปวช., ปวส., ธุรกิจดิจิทัล, เชียงราย" />
    <meta name="author" content="แผนกวิชาเทคโนโลยีธุรกิจดิจิทัล วิทยาลัยอาชีวศึกษาเชียงราย" />
    <meta name="theme-color" content="#5f2d8c" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Social Media Preview -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Digital Business Technology CVC" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Structured Data (JSON-LD) for Rich Snippets -->
    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "EducationalOrganization",
      "name": "แผนกวิชาเทคโนโลยีธุรกิจดิจิทัล วิทยาลัยอาชีวศึกษาเชียงราย",
      "alternateName": "Digital Business Technology Department CVC",
      "url": "https://cvcdigitalbusinesstechnology.netlify.app",
      "logo": "https://cvcdigitalbusinesstechnology.netlify.app/02_design/DBTLOGO.webp",
      "description": "หลักสูตรวิชาชีพด้านเทคโนโลยีธุรกิจดิจิทัล นวัตกรรมธุรกิจ ข้อมูลและอีคอมเมิร์ซ วิทยาลัยอาชีวศึกษาเชียงราย",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "เมืองเชียงราย",
        "addressRegion": "เชียงราย",
        "addressCountry": "TH"
      },
      "sameAs": [
        "https://cvc.ac.th",
        "https://admission.vec.go.th/"
      ]
    }
    </script>

    <!-- PWA & Web App Icons -->
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" type="image/webp" href="/02_design/DBTLOGO.webp" />
    <link rel="apple-touch-icon" href="/02_design/DBTLOGO.webp" />

    <!-- Preload Critical Assets (LCP Optimization) -->
    {isHome && (
        <link rel="preload" as="image" href="/02_design/hero-poster.webp" fetchpriority="high" />
    )}

    <!-- Google Web Fonts (Optimized essential weights for blazing-fast mobile rendering) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Icon Font Stylesheet (Asynchronously Loaded to Eliminate Render-Blocking) -->
    <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" /></noscript>

    <!-- Tailwind CSS -->
    <link href="/include/css/tailwind.css" rel="stylesheet" />

    <!-- Custom Stylesheet with Smart Caching -->
    <link rel="stylesheet" href="/include/css/test.css" />

    <!-- Subpage Module Stylesheets (Conditional Route Loading) -->
    {moduleCss && <link rel="stylesheet" href={moduleCss} />}
</head>

<body class="bg-neutral-bg text-neutral-text relative font-sans overflow-x-hidden">
    <!-- Fast Network-Adaptive PJAX Top Loading Indicator -->
    <div id="page-progress-bar" style="position: fixed; top: 0; left: 0; height: 3px; width: 0%; background: #5f2d8c; z-index: 9999999; transition: width 0.2s cubic-bezier(0.1, 0.9, 0.2, 1), opacity 0.3s ease; pointer-events: none; opacity: 0; box-shadow: 0 0 10px #5f2d8c, 0 0 5px #8b5cf6;"></div>

    <!-- Cinematic Dark Tech Preloader -->
    <Preloader />

    <!-- Background Grid Pattern -->
    <div class="fixed inset-0 bg-grid-pattern pointer-events-none z-0 opacity-80" id="globalGridBg"></div>

    <div class="relative z-10 w-full">
        <!-- Main Navbar -->
        <Navbar currentPath={currentPath} />

        <!-- Main Content Slot -->
        <main id="swup-container">
            <slot />
        </main>

        <!-- Footer -->
        <Footer />
    </div>

    <!-- GSAP Core & High-Performance Plugins -->
    <script is:inline src="/include/js/vendor/gsap.min.js"></script>
    <script is:inline src="/include/js/vendor/ScrollTrigger.min.js"></script>
    <script is:inline src="/include/js/vendor/Observer.min.js"></script>
    <script is:inline>
        if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined' && typeof Observer !== 'undefined') {
            gsap.registerPlugin(ScrollTrigger, Observer);
        }
    </script>

    <!-- Lenis & Core Javascript -->
    <script is:inline src="/include/js/lenis.min.js"></script>
    <script is:inline src="/include/js/main.js"></script>
    <script is:inline src="/include/js/test.js"></script>

    <!-- Subpage Interactive Modules (Conditional Route Loading) -->
    {moduleJs && <script is:inline src={moduleJs}></script>}

    <!-- GSAP & Awwwards Page Transitions and Interactions -->
    <script is:inline src="/include/js/awwwards.js"></script>

    <script is:inline>
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                const targetId = this.getAttribute('href').substring(1);
                if (!targetId) return;
                const targetElement = document.getElementById(targetId);
                if (targetElement) {
                    e.preventDefault();
                    if (typeof window.lenis?.scrollTo === 'function') {
                        window.lenis.scrollTo(targetElement, { offset: -50 });
                    } else {
                        targetElement.scrollIntoView({
                            behavior: 'smooth',
                            block: 'center',
                        });
                    }
                }
            });
        });
    </script>
</body>
</html>
